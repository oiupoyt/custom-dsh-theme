{
  "name": "custom-dsh-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal square-minimal obsidian theme for the DeepSeek Harness web GUI. Sits beside dsh-claude-style and repaints it.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
